        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;mermaid\nerDiagram\n    users ||--o{ user_roles : has\n    roles ||--o{ user_roles : grants\n    users ||--o{ friendships : \&quot;requests (requester_id)\&quot;\n    users ||--o{ friendships : \&quot;receives (addressee_id)\&quot;\n    users ||--o{ conversations : \&quot;creates (created_by)\&quot;\n    users ||--o{ conversation_members : joins\n    conversations ||--o{ conversation_members : has\n    conversations ||--o{ messages : contains\n    users ||--o{ messages : sends\n    messages |o--o{ messages : \&quot;reply_to\&quot;\n    messages ||--o{ attachments : has\n    conversations |o--o| messages : \&quot;last_message\&quot;\n    conversation_members }o--o| messages : \&quot;last_read\&quot;\n    users ||--o{ notifications : receives\n\n    users {\n        BIGINT id PK\n        VARCHAR username UK\n        VARCHAR email UK\n        VARCHAR password_hash\n        VARCHAR display_name\n        VARCHAR avatar_url\n        VARCHAR status\n        DATETIME last_seen_at\n        DATETIME created_at\n        DATETIME updated_at\n    }\n    roles {\n        BIGINT id PK\n        VARCHAR name UK\n        VARCHAR description\n    }\n    user_roles {\n        BIGINT user_id PK,FK\n        BIGINT role_id PK,FK\n        DATETIME assigned_at\n    }\n    friendships {\n        BIGINT id PK\n        BIGINT requester_id FK\n        BIGINT addressee_id FK\n        VARCHAR status\n        DATETIME created_at\n        DATETIME updated_at\n    }\n    conversations {\n        BIGINT id PK\n        VARCHAR type\n        VARCHAR name\n        VARCHAR avatar_url\n        VARCHAR direct_key UK\n        BIGINT created_by FK\n        BIGINT last_message_id FK\n        DATETIME last_message_at\n        DATETIME created_at\n        DATETIME updated_at\n    }\n    conversation_members {\n        BIGINT id PK\n        BIGINT conversation_id FK\n        BIGINT user_id FK\n        VARCHAR role\n        BIGINT last_read_message_id FK\n        DATETIME muted_until\n        DATETIME joined_at\n        DATETIME left_at\n    }\n    messages {\n        BIGINT id PK\n        BIGINT conversation_id FK\n        BIGINT sender_id FK\n        VARCHAR client_message_id\n        VARCHAR type\n        TEXT content\n        BIGINT reply_to_message_id FK\n        DATETIME created_at\n        DATETIME updated_at\n        DATETIME deleted_at\n    }\n    attachments {\n        BIGINT id PK\n        BIGINT message_id FK\n        VARCHAR file_name\n        VARCHAR file_url\n        VARCHAR mime_type\n        BIGINT file_size\n        DATETIME created_at\n    }\n    notifications {\n        BIGINT id PK\n        BIGINT user_id FK\n        VARCHAR type\n        VARCHAR title\n        TEXT content\n        VARCHAR reference_type\n        BIGINT reference_id\n        BOOLEAN is_read\n        DATETIME read_at\n        DATETIME created_at\n    }\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="mNaAqGI-Fww8ZuesYkWA-1">
