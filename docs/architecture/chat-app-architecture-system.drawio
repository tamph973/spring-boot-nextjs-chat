        <mxCell id="docker" parent="1" style="swimlane;startSize=30;rounded=1;arcSize=2;dashed=1;dashPattern=8 4;strokeColor=#1d63ed;strokeWidth=2;fillColor=#1d63ed;fontColor=#ffffff;swimlaneFillColor=#f7faff;fontStyle=1;fontSize=14;html=1;" value="Docker Host — docker-compose · network: chat-net" vertex="1">
          <mxGeometry height="850" width="1340" x="340" y="60" as="geometry" />
        </mxCell>
        <mxCell id="nginx" parent="docker" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" value="&lt;b&gt;Nginx&lt;/b&gt; (reverse proxy)&lt;br&gt;&lt;i&gt;nginx:alpine · :80 / :443&lt;/i&gt;&lt;hr&gt;• TLS termination&lt;br&gt;• / → frontend:3000&lt;br&gt;• /api/** → backend:8080&lt;br&gt;• /ws → Upgrade + ip_hash (sticky)" vertex="1">
          <mxGeometry height="200" width="200" x="40" y="340" as="geometry" />
        </mxCell>
        <mxCell id="frontend" parent="docker" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;fontSize=12;" value="&lt;b&gt;Next.js Server&lt;/b&gt; — container: frontend&lt;br&gt;&lt;i&gt;node:20-alpine · :3000&lt;/i&gt;&lt;hr&gt;App Router · SSR / Server Components · Middleware (auth redirect) · static assets" vertex="1">
          <mxGeometry height="140" width="500" x="340" y="50" as="geometry" />
        </mxCell>
        <mxCell id="sb1" parent="docker" style="swimlane;startSize=30;rounded=1;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f4fbf3;fontStyle=1;fontSize=13;html=1;" value="Spring Boot — container: backend-1 · eclipse-temurin:21-jre · :8080" vertex="1">
