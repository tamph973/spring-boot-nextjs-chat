<mxfile host="app.diagrams.net" agent="design">
  <diagram id="chat-arch" name="System Architecture">
    <mxGraphModel dx="2050" dy="1321" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1720" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size:22px&quot;&gt;Chat Application — System Architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#555555&quot;&gt;Next.js + TypeScript · Spring Boot · WebSocket (STOMP) · Redis · MySQL · Docker Compose&lt;/span&gt;" vertex="1">
