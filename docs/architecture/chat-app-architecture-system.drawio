        <mxCell id="redis" parent="docker" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Redis 8.x&lt;/b&gt;&lt;br&gt;&lt;i&gt;container: redis · :6379 · volume: redis_data&lt;/i&gt;&lt;hr&gt;Pub/Sub: chat.room.{id} (fan-out giữa instances)&lt;br&gt;Presence: online:{userId} (TTL)&lt;br&gt;Typing: typing:{roomId} (TTL ngắn)&lt;br&gt;Cache: user profile, conversation list&lt;br&gt;Rate limit · refresh-token blacklist" vertex="1">
          <mxGeometry height="250" width="380" x="920" y="550" as="geometry" />
