          <mxGeometry height="60" width="200" x="20" y="205" as="geometry" />
        </mxCell>
        <mxCell id="cState" parent="client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;fontSize=11;fontColor=#555555;" value="State: React Query / Zustand" vertex="1">
