        <mxCell id="flow" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Luồng gửi 1 tin nhắn (realtime)&lt;/b&gt;&lt;hr&gt;① Client SEND /app/chat.send qua WSS&lt;br&gt;② Nginx chuyển tới backend-1 (sticky)&lt;br&gt;③ ChannelInterceptor xác thực JWT&lt;br&gt;④ MessageService lưu messages → MySQL&lt;br&gt;⑤ PUBLISH chat.room.{id} → Redis&lt;br&gt;⑥ Mọi backend đang SUBSCRIBE nhận event, đẩy /topic/room.{id} tới client của mình" vertex="1">
